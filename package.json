{
  "name": "@apackdev/link",
  "version": "0.1.0",
  "description": "One ordered stream between two systems: what one sends the other arrives once, in the order it was sent, or the sender is told it did not.",
  "private": true,
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE",
    "REFERENCE.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spankyed/apack-link.git"
  },
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "build": "node node_modules/typescript/bin/tsc -p tsconfig.build.json",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "typecheck:floor": "node node_modules/typescript-5.7/bin/tsc --noEmit -p tsconfig.floor.json",
    "test": "vitest run --project node",
    "test:browser": "vitest run --project browser",
    "test:watch": "vitest",
    "prepack": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && npm run build",
    "reference:check": "node scripts/reference.mjs",
    "reference:update": "node scripts/reference.mjs --write",
    "package:lint": "node scripts/package-lint.mjs",
    "package:smoke": "node scripts/package-smoke.mjs",
    "workflows:check": "node scripts/workflows-check.mjs",
    "fuzz": "node scripts/fuzz.mjs",
    "mutants": "stryker run"
  },
  "peerDependencies": {
    "@apackdev/orderings": "*"
  },
  "peerDependenciesMeta": {
    "@apackdev/orderings": {
      "optional": true
    }
  },
  "devDependencies": {
    "@apackdev/orderings": "https://github.com/spankyed/apack-orderings/releases/download/pkg-970d286ecf671402fe0ce18b9c30b4f7a1e6174c/apackdev-orderings-0.1.0.tgz",
    "@arethetypeswrong/cli": "^0.18.5",
    "@msgpack/msgpack": "^3.1.3",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/node": "^24.1.0",
    "@types/ws": "^8.18.2",
    "@vitest/browser-playwright": "^4.1.12",
    "playwright": "^1.65.1",
    "publint": "^0.3.25",
    "typescript": "^5.9.3",
    "typescript-5.7": "npm:typescript@~5.7.3",
    "vitest": "^4.1.12",
    "ws": "^8.23.0"
  }
}
