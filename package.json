{
  "name": "@apackdev/link",
  "version": "0.1.0",
  "description": "One ordered stream between two systems: what one sends the other arrives once, in the order it was sent, or the sender is told it did not.",
  "private": true,
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE",
    "REFERENCE.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spankyed/apack-link.git"
  },
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && npm run build",
    "reference:check": "node scripts/reference.mjs",
    "reference:update": "node scripts/reference.mjs --write",
    "package:smoke": "node scripts/package-smoke.mjs",
    "workflows:check": "node scripts/workflows-check.mjs"
  },
  "peerDependencies": {
    "@apackdev/orderings": "*"
  },
  "peerDependenciesMeta": {
    "@apackdev/orderings": {
      "optional": true
    }
  },
  "devDependencies": {
    "@apackdev/orderings": "https://github.com/spankyed/apack-orderings/releases/download/pkg-6537a60ef6793249bfee2354f906c48e02743bb7/apackdev-orderings-0.1.0.tgz",
    "@msgpack/msgpack": "^3.1.3",
    "@types/node": "^24.1.0",
    "@types/ws": "^8.18.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12",
    "ws": "^8.23.0"
  }
}
